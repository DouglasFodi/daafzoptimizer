Windows Registry Editor Version 5.00

;Altera a paginação de memória utilizada do windows(verificação feita pelo Gerenciador de Tarefas) o cálculo é feito através a memória que o usuário possui.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control]
;; "SvcHostSplitThresholdInKB"=dword:02000000
"SvcHostSplitThresholdInKB"=dword:04000000
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control]
;; "SvcHostSplitThresholdInKB"=dword:02000000
"SvcHostSplitThresholdInKB"=dword:04000000
;Ativar calendário do PC e Desativa o Centro de Notificações do Windows, impedindo que ele exiba notificações.
[HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Windows\Explorer]
;; "DisableNotificationCenter"=dword:00000001 ;usar para desativar calendário
"DisableNotificationCenter"=dword:00000000
"DisableSearchBoxSuggestions"=dword:00000001
;OBS: A indexação de arquivos permite que o Windows encontre arquivos mais rapidamente comentar linha caso o cliente não queira
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"DisableIndexing"=dword:00000001
;DirectXUserGlobalSettings indica que a otimização para VR (realidade virtual) está desativada e o caminho do executável do jogo define a preferência de GPU para priorizar uma GPU dedicada em vez de uma integrada.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\DirectX\UserGpuPreferences]
"DirectXUserGlobalSettings"="VRROptimizeEnable=0;"
"C:\Program Files (x86)\Steam\steamapps\common\Delta Force\Game\DeltaForce\Binaries\Win64\DeltaForceClient-Win64-Shipping.exe"="GpuPreference=2;"
"C:\Program Files (x86)\Steam\steamapps\common\Delta Force\Game\DeltaForceClient.exe"="GpuPreference=2;"
;define a prioridade de classe e da prioridade a cpu no PUBG, adicionar novos jogos caso necessário e solicitado pelo cliente.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\TslGame.exe\PerfOptions]
"CpuPriorityClass"=dword:00000003
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\DeltaForceClient-Win64-Shipping.exe\PerfOptions]
"CpuPriorityClass"=dword:00000003
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\DeltaForceClient.exe\PerfOptions]
"CpuPriorityClass"=dword:00000003
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects]
"VisualFXSetting"=dword:00000003
;Desabilita a animação da tela ao minimizar ou maximizar
[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]
"MinAnimate"=dword:00000000
;Desativa animações podendo fazer com que a interface do usuário responda mais rapidamente, especialmente em sistemas mais lentos.
[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]
