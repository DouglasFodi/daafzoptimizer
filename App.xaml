<Application x:Class="RegOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#111111"/>
        <SolidColorBrush x:Key="Panel" Color="#181818"/>
        <SolidColorBrush x:Key="Panel2" Color="#202020"/>
        <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Text" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="Muted" Color="#A1A1AA"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Application.Resources>
</Application>
