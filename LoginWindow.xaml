<Window x:Class="RegOptimizer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RegOptimizer — Acesso"
        Width="470" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        Loaded="Window_Loaded">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Width="62" Height="62" CornerRadius="15" Background="{StaticResource Accent}"
                HorizontalAlignment="Left">
            <TextBlock Text="✓" FontSize="37" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Grid.Row="1" Text="Acesso ao RegOptimizer" FontSize="24" FontWeight="SemiBold" Margin="0,22,0,0"/>
        <TextBlock Grid.Row="2"
                   Text="Digite a senha de acesso. A senha é validada pelo servidor e não fica armazenada neste computador."
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>

        <Border Grid.Row="3" Background="{StaticResource Panel2}" BorderBrush="#333333" BorderThickness="1" CornerRadius="7">
            <PasswordBox x:Name="PasswordInput" Background="Transparent" Foreground="White" BorderThickness="0"
                         FontSize="15" Padding="12,10" KeyDown="PasswordInput_KeyDown"/>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="2,10,2,0" MinHeight="38"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Sair" Width="92" Click="Exit_Click"/>
            <Button x:Name="LoginButton" Content="Entrar" Width="120" Background="{StaticResource Accent}" Click="Login_Click"/>
        </StackPanel>
    </Grid>
</Window>
